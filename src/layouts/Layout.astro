---
import { basics } from "@cv"

interface Props {
  title: string
}

const { title } = Astro.props
const { image, summary, url } = basics
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href={image} />

    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content="" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={url.split("//")[1] ?? ''} />
    <meta property="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content="" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..800;1,14..32,300..500&display=swap');

  /* ─── Design tokens ──────────────────────────────────────── */
  :root {
    /* Backgrounds */
    --bg:           #080c14;
    --surface:      rgba(14, 20, 36, 0.7);
    --surface-hov:  rgba(18, 26, 46, 0.8);

    /* Borders */
    --border:       rgba(255, 255, 255, 0.07);
    --border-hov:   rgba(255, 255, 255, 0.13);

    /* Text */
    --text-1: #eef2ff;
    --text-2: #8892a4;
    --text-3: #44526a;

    /* Accent — blue-violet */
    --accent:        #4f7ef8;
    --accent-2:      #7c5cf6;
    --accent-muted:  rgba(79, 126, 248, 0.1);
    --accent-border: rgba(79, 126, 248, 0.22);

    /* Status */
    --green:        #10b981;
    --green-muted:  rgba(16, 185, 129, 0.1);
    --green-border: rgba(16, 185, 129, 0.22);

    /* Radius scale */
    --r-xs: 6px;
    --r-sm: 9px;
    --r-md: 13px;
    --r-lg: 18px;
    --r-xl: 24px;
    --r-full: 9999px;

    /* Transitions */
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
    --t-fast: 0.2s;
    --t-base: 0.3s;
  }

  /* ─── Reset ──────────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; }

  figure { margin: 0; padding: 0; }

  ul { list-style: none; margin: 0; padding: 0; }

  a {
    text-decoration: none;
    transition: color var(--t-fast) var(--ease);
  }

  /* ─── Base ───────────────────────────────────────────────── */
  html {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg);
    background-attachment: fixed;
    letter-spacing: -0.02rem;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    color: var(--text-1);
    position: relative;
    overflow-x: hidden;
  }

  /* Single ambient glow — no más ruido de colores compitiendo */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 90% 50% at 50% -8%,  rgba(79, 126, 248, 0.11) 0%, transparent 62%),
      radial-gradient(ellipse 50% 40% at 90% 95%,  rgba(124, 92, 246, 0.06) 0%, transparent 58%);
    pointer-events: none;
    z-index: 0;
  }

  body > * { position: relative; z-index: 1; }

  /* ─── Typography ─────────────────────────────────────────── */
  h1, h2, h3, h4 {
    margin: 0;
    font-family: inherit;
    line-height: 1.2;
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    background: linear-gradient(140deg, #ffffff 0%, #c7d4ff 60%, #a5b4fc 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* h2 SIN decoración global — la maneja Section.astro de forma scoped */
  h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    color: var(--text-1);
    letter-spacing: -0.02em;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-1);
  }

  h4 {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-2);
  }

  p {
    color: var(--text-2);
    font-size: 0.925rem;
    line-height: 1.75;
    margin: 0;
    text-wrap: pretty;
  }

  /* ─── Print ──────────────────────────────────────────────── */
  .print { display: none !important; }

  @media print {
    .no-print { display: none !important; }
    .print    { display: block !important; }
    astro-dev-toolbar { display: none !important; }
    article { break-inside: avoid; }
  }
</style>
