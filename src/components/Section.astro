---
const { title, id } = Astro.props
---

<section id={id}>
  {title && (
    <header class="section-header">
      <h2>{title}</h2>
    </header>
  )}
  <slot />
</section>

<style>
  section {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 0;
    position: relative;
    scroll-margin-top: 90px;
  }

  section + section {
    border-top: 1px solid var(--border);
  }

  /* ── Section header ──────────────────────────────────────── */
  .section-header {
    margin-bottom: 2.5rem;
  }

  h2 {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: var(--text-1);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0;
  }

  /* Barra vertical izquierda — reemplaza el underline anterior */
  h2::before {
    content: '';
    display: block;
    width: 3px;
    height: 1.1em;
    border-radius: 3px;
    background: linear-gradient(to bottom, var(--accent), var(--accent-2));
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    section {
      padding: 2.75rem 0;
    }

    .section-header {
      margin-bottom: 2rem;
    }
  }
</style>
