---
// se ejecuta en el servidor o en build time <----
const { title } = Astro.props
---

<section>
  {title && <h2>{title}</h2>}
  <slot />
</section>

<script>
  // se ejecuta en el cliente <----
</script>

<style>
  section {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 0;
    position: relative;
  }

  section:not(:first-child) {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  h2 {
    margin-bottom: 2rem;
    font-weight: 700;
    line-height: 1.3;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: #f1f5f9;
    position: relative;
    display: inline-block;
  }

  h2::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6);
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    section {
      padding: 2rem 0;
    }

    h2 {
      margin-bottom: 1.5rem;
    }
  }
</style>
