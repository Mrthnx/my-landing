---
import Section from "../Section.astro"
import GitHub from "@/icons/GitHub.astro"
import { ExternalLink, CircleDot } from 'lucide-astro'
import { projects } from "@cv"
---

<Section title="Proyectos" id="projects">
  <div class="projects-grid">
    {
      projects.map(({ url, description, highlights, name, isActive, github }) => (
        <div class="project-card">
          <div class="card-header">
            <div class="project-info">
              <div class="project-title-row">
                <h3 class="project-name">{name}</h3>
                {isActive && (
                  <span class="active-badge">
                    <CircleDot size={11} />
                    En producción
                  </span>
                )}
              </div>
            </div>
            <div class="project-actions">
              {github && (
                <a class="action-btn" href={github} target="_blank" title={`Código fuente de ${name}`}>
                  <GitHub />
                </a>
              )}
              {url && (
                <a class="action-btn" href={url} target="_blank" title={`Ver ${name}`}>
                  <ExternalLink size={16} />
                </a>
              )}
            </div>
          </div>

          <div class="card-body">
            <p class="project-description">{description}</p>
          </div>

          <div class="card-footer">
            <div class="project-tags">
              {highlights.map((tag: string) => (
                <span class="project-tag">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: all var(--t-base) var(--ease);
    position: relative;
    overflow: hidden;
    height: 100%;
  }

  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover {
    background: var(--surface-hov);
    border-color: var(--border-hov);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .project-card:hover::before {
    opacity: 1;
  }

  /* Header */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .project-info {
    flex: 1;
    min-width: 0;
  }

  .project-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .project-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #f1f5f9;
    margin: 0;
    line-height: 1.3;
  }

  .active-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.25);
    color: #4ade80;
    padding: 0.2rem 0.55rem;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .project-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-shrink: 0;
  }

  .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9px;
    color: #64748b;
    transition: all 0.25s ease;
  }

  .action-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
    transform: translateY(-1px);
  }

  /* Body */
  .card-body {
    flex: 1;
  }

  .project-description {
    color: #64748b;
    line-height: 1.7;
    margin: 0;
    font-size: 0.875rem;
  }

  /* Footer */
  .card-footer {
    margin-top: auto;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .project-tag {
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.2);
    color: #60a5fa;
    padding: 0.2rem 0.6rem;
    border-radius: 7px;
    font-size: 0.72rem;
    font-weight: 500;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .project-tag:hover {
    background: rgba(59, 130, 246, 0.14);
    border-color: rgba(59, 130, 246, 0.3);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      padding: 1.25rem;
    }
  }
</style>
