---
import Section from "../Section.astro"
import { Rocket, Code2, Globe, Target } from 'lucide-astro'
import { basics } from "@cv"

const { summary } = basics

const ACHIEVEMENTS = [
  { icon: Rocket, value: '6+', label: 'Años de experiencia', color: '#ff6b35' },
  { icon: Code2, value: '4',   label: 'Empresas / clientes', color: '#ff6b35' },
  { icon: Globe, value: '5+',  label: 'Países con impacto', color: '#ff6b35' },
  { icon: Target, value: '100%', label: 'Orientado a resultados', color: '#ff6b35' },
]
---

<Section title="Sobre mí" id="about">
  <div class="about-content">

    <div class="about-text">
      <p class="about-summary">{summary}</p>
      <div class="about-highlights">
        <div class="highlight-item">
          <span class="highlight-dot blue"></span>
          <span>Diseño e implementación de APIs robustas y seguras</span>
        </div>
        <div class="highlight-item">
          <span class="highlight-dot purple"></span>
          <span>Microservicios desacoplados con foco en performance</span>
        </div>
        <div class="highlight-item">
          <span class="highlight-dot cyan"></span>
          <span>Arquitectura cloud en AWS (Lambda, EC2, S3, SNS, SQS)</span>
        </div>
        <div class="highlight-item">
          <span class="highlight-dot green"></span>
          <span>Integración con servicios fintech, pagos y terceros</span>
        </div>
      </div>
    </div>

    <div class="about-stats">
      {ACHIEVEMENTS.map(({ icon: Icon, value, label, color }) => (
        <div class="stat-card" style={`--accent: ${color}`}>
          <div class="stat-icon">
            <Icon size={20} />
          </div>
          <div class="stat-body">
            <div class="stat-number">{value}</div>
            <div class="stat-label">{label}</div>
          </div>
        </div>
      ))}
    </div>

  </div>
</Section>

<style>
  .about-content {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 3rem;
    align-items: start;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .about-summary {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--text-2);
    margin: 0;
  }

  .about-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.5;
  }

  .highlight-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--accent);
  }

  .highlight-dot.blue,
  .highlight-dot.purple,
  .highlight-dot.cyan,
  .highlight-dot.green { background: var(--accent); }

  /* Stats */
  .about-stats {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: all var(--t-base) var(--ease);
    position: relative;
    overflow: hidden;
  }

  .stat-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    border-radius: 3px 0 0 3px;
    opacity: 0.8;
  }

  .stat-card:hover {
    background: var(--surface-hov);
    border-color: var(--border-hov);
    transform: translateX(3px);
  }

  .stat-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .stat-body {
    flex: 1;
    min-width: 0;
  }

  .stat-number {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 0.2rem;
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--text-2);
    font-weight: 500;
    line-height: 1.3;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .stat-card:hover {
      transform: translateY(-2px);
    }

    .stat-card::before {
      left: 0;
      top: 0;
      right: 0;
      bottom: auto;
      width: auto;
      height: 3px;
      border-radius: 3px 3px 0 0;
    }
  }

  @media (max-width: 480px) {
    .about-stats {
      grid-template-columns: 1fr;
    }

    .about-summary {
      font-size: 0.95rem;
    }
  }
</style>
