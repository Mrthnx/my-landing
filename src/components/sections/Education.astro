---
import Section from "../Section.astro"

import { education } from "@cv"
---

<Section title="Educación">
  <div class="education-container">
    {
      education.map(({ institution, startDate, endDate, area, url }) => {
        const startYear = new Date(startDate).getFullYear()
        const endYear =
          endDate != null ? new Date(endDate).getFullYear() : "Actual"
        const years = `${startYear} - ${endYear}`

        return (
          <div class="education-card">
            <div class="education-header">
              <div class="institution-info">
                <h3 class="institution-name">
                  {url ? (
                    <a href={url} target="_blank" title={`Ver ${institution}`}>
                      {institution}
                    </a>
                  ) : (
                    institution
                  )}
                </h3>
                <p class="degree-area">{area}</p>
              </div>
              <div class="education-period">
                <span class="period-badge">{years}</span>
              </div>
            </div>
            <div class="education-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 14L8 10L10.5 7.5L12 9L17 4L19.5 6.5L12 14Z" fill="currentColor"/>
                <path d="M12 2L22 9L12 16L2 9L12 2Z" stroke="currentColor" stroke-width="2" fill="none"/>
              </svg>
            </div>
          </div>
        )
      })
    }
  </div>
</Section>

<style>
  .education-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .education-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 2rem;
    backdrop-filter: blur(10px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .education-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(34, 197, 94, 0.5), transparent);
  }

  .education-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-4px);
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .education-header {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .institution-info {
    flex: 1;
    min-width: 0;
  }

  .institution-name {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .institution-name a {
    color: #f1f5f9;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .institution-name a:hover {
    color: #22c55e;
    text-shadow: 0 0 8px rgba(34, 197, 94, 0.4);
  }

  .degree-area {
    color: #94a3b8;
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.4;
  }

  .education-period {
    flex-shrink: 0;
  }

  .period-badge {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #86efac;
    padding: 0.5rem 1rem;
    border-radius: 12px;
    font-size: 0.875rem;
    font-weight: 500;
    backdrop-filter: blur(10px);
  }

  .education-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #86efac;
    transition: all 0.3s ease;
  }

  .education-card:hover .education-icon {
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.3);
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(34, 197, 94, 0.2);
  }

  @media (max-width: 768px) {
    .education-card {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1.5rem;
    }

    .education-header {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .education-period {
      align-self: flex-start;
    }

    .education-icon {
      align-self: center;
      width: 40px;
      height: 40px;
    }

    .institution-name {
      font-size: 1.1rem;
    }

    .degree-area {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .education-card {
      padding: 1.25rem;
    }

    .institution-name {
      font-size: 1rem;
    }

    .degree-area {
      font-size: 0.85rem;
    }
  }
</style>
