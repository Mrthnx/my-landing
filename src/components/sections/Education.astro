---
import Section from "../Section.astro"
import { GraduationCap, Calendar } from 'lucide-astro'
import { education } from "@cv"
---

<Section title="Educación" id="education">
  <div class="education-container">
    {
      education.map(({ institution, startDate, endDate, area, studyType, url }) => {
        const startYear = new Date(startDate).getFullYear()
        const endYear = endDate != null ? new Date(endDate).getFullYear() : 'Actualidad'
        const years = `${startYear} – ${endYear}`

        return (
          <div class="education-card">
            <div class="edu-icon">
              <GraduationCap size={22} />
            </div>

            <div class="edu-body">
              <div class="edu-header">
                <div class="edu-info">
                  <h3 class="institution-name">
                    {url
                      ? <a href={url} target="_blank" rel="noopener noreferrer">{institution}</a>
                      : institution
                    }
                  </h3>
                  <p class="degree">
                    <span class="study-type">{studyType}</span>
                    <span class="degree-sep">·</span>
                    <span class="degree-area">{area}</span>
                  </p>
                </div>

                <div class="edu-period">
                  <span class="period-badge">
                    <Calendar size={12} />
                    {years}
                  </span>
                </div>
              </div>
            </div>
          </div>
        )
      })
    }
  </div>
</Section>

<style>
  .education-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .education-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    transition: all var(--t-base) var(--ease);
    position: relative;
    overflow: hidden;
  }

  .education-card:hover {
    background: var(--surface-hov);
    border-color: var(--border-hov);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .edu-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background: var(--accent-muted);
    border: 1px solid var(--accent-border);
    border-radius: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    transition: all 0.3s ease;
  }

  .education-card:hover .edu-icon {
    background: rgba(255, 107, 53, 0.12);
  }

  .edu-body {
    flex: 1;
    min-width: 0;
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .edu-info {
    flex: 1;
    min-width: 0;
  }

  .institution-name {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
  }

  .institution-name a {
    color: var(--text-1);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .institution-name a:hover {
    color: var(--accent);
  }

  .degree {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--text-2);
    margin: 0;
    flex-wrap: wrap;
  }

  .study-type {
    color: var(--accent);
    font-weight: 600;
  }

  .degree-sep {
    color: var(--text-3);
  }

  .degree-area {
    color: var(--text-2);
  }

  .edu-period {
    flex-shrink: 0;
  }

  .period-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--surface-hov);
    border: 1px solid var(--border);
    color: var(--text-2);
    padding: 0.4rem 0.875rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .education-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .edu-header {
      flex-direction: column;
      gap: 0.75rem;
    }

    .edu-period {
      align-self: flex-start;
    }
  }
</style>
