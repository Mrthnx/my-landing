---
import Section from "../Section.astro"
import { Building2, Calendar, ExternalLink } from 'lucide-astro'
import { work } from "@cv"

const formatDate = (dateStr: string | null) => {
  if (!dateStr) return 'Actualidad'
  const date = new Date(dateStr)
  return date.toLocaleDateString('es-PE', { month: 'short', year: 'numeric' })
}

const getDuration = (startDate: string, endDate: string | null) => {
  const start = new Date(startDate)
  const end = endDate ? new Date(endDate) : new Date()
  const months = (end.getFullYear() - start.getFullYear()) * 12 + (end.getMonth() - start.getMonth())
  if (months < 12) return `${months} mes${months === 1 ? '' : 'es'}`
  const years = Math.floor(months / 12)
  const rem = months % 12
  return rem > 0 ? `${years} año${years > 1 ? 's' : ''} ${rem} mes${rem > 1 ? 'es' : ''}` : `${years} año${years > 1 ? 's' : ''}`
}
---

<Section title="Experiencia laboral" id="experience">
  <div class="experience-timeline">
    {
      work.map(({ name, startDate, endDate, position, summary, highlights, url }, index) => {
        const start = formatDate(startDate)
        const end = formatDate(endDate)
        const duration = getDuration(startDate, endDate)
        const isActive = endDate === null

        return (
          <div class={`timeline-item ${isActive ? 'active' : ''}`}>
            <div class="timeline-marker">
              <div class={`timeline-dot ${isActive ? 'dot-active' : ''}`}></div>
              {index < work.length - 1 && <div class="timeline-line"></div>}
            </div>

            <div class="timeline-content">
              <div class="experience-card">

                <div class="card-header">
                  <div class="company-block">
                    <div class="company-icon">
                      <Building2 size={18} />
                    </div>
                    <div class="company-info">
                      <h3 class="company-name">
                        {url
                          ? <a href={url} target="_blank" rel="noopener noreferrer">{name} <ExternalLink size={13} class="ext-icon" /></a>
                          : name
                        }
                      </h3>
                      <span class="position-title">{position}</span>
                    </div>
                  </div>

                  <div class="date-block">
                    <div class="date-badge">
                      <Calendar size={13} />
                      <span>{start} – {end}</span>
                    </div>
                    <span class="duration-badge">{duration}</span>
                  </div>
                </div>

                <div class="card-body">
                  <p class="job-description">{summary}</p>

                  {highlights && highlights.length > 0 && (
                    <div class="tech-stack">
                      <span class="tech-label">Stack:</span>
                      <div class="tech-tags">
                        {highlights.map((tag: string) => (
                          <span class="tech-tag">{tag}</span>
                        ))}
                      </div>
                    </div>
                  )}
                </div>

              </div>
            </div>
          </div>
        )
      })
    }
  </div>
</Section>

<style>
  .experience-timeline {
    position: relative;
  }

  .timeline-item {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    position: relative;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  /* Timeline marker */
  .timeline-marker {
    position: relative;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
    padding-top: 4px;
  }

  .timeline-dot {
    width: 14px;
    height: 14px;
    background: rgba(100, 116, 139, 0.5);
    border: 2px solid rgba(100, 116, 139, 0.4);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .timeline-dot.dot-active {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 0 16px rgba(59, 130, 246, 0.4);
  }

  .timeline-line {
    width: 2px;
    flex: 1;
    min-height: 40px;
    background: linear-gradient(to bottom, rgba(59, 130, 246, 0.3), rgba(59, 130, 246, 0.05));
    margin-top: 6px;
  }

  /* Card */
  .timeline-content {
    flex: 1;
    min-width: 0;
  }

  .experience-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 1.75rem;
    transition: all var(--t-base) var(--ease);
    position: relative;
    overflow: hidden;
  }

  .active .experience-card {
    border-color: var(--accent-border);
    background: color-mix(in srgb, var(--accent) 4%, var(--surface));
  }

  .experience-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent) 50%, transparent);
    opacity: 0;
    transition: opacity var(--t-base) var(--ease);
  }

  .experience-card:hover {
    background: var(--surface-hov);
    border-color: var(--border-hov);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  }

  .experience-card:hover::before {
    opacity: 1;
  }

  /* Header */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .company-block {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .company-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--r-sm);
    background: var(--accent-muted);
    border: 1px solid var(--accent-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .company-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .company-name {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .company-name a {
    color: #f1f5f9;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s ease;
  }

  .company-name a:hover {
    color: #60a5fa;
  }

  .ext-icon {
    opacity: 0.5;
    flex-shrink: 0;
  }

  .position-title {
    font-size: 0.875rem;
    color: #60a5fa;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Date block */
  .date-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .date-badge {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-2);
    padding: 0.35rem 0.75rem;
    border-radius: var(--r-sm);
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .duration-badge {
    font-size: 0.72rem;
    color: var(--text-3);
    font-weight: 400;
  }

  /* Body */
  .job-description {
    color: #94a3b8;
    line-height: 1.75;
    margin: 0 0 1.25rem 0;
    font-size: 0.9rem;
  }

  /* Tech stack */
  .tech-stack {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .tech-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tech-tag {
    background: var(--accent-muted);
    border: 1px solid var(--accent-border);
    color: #93c5fd;
    padding: 0.2rem 0.6rem;
    border-radius: var(--r-xs);
    font-size: 0.72rem;
    font-weight: 500;
    transition: all var(--t-fast) var(--ease);
    white-space: nowrap;
  }

  .tech-tag:hover {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .timeline-item {
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .experience-card {
      padding: 1.25rem;
    }

    .card-header {
      flex-direction: column;
      gap: 1rem;
    }

    .date-block {
      align-items: flex-start;
      flex-direction: row;
      align-items: center;
    }
  }

  @media (max-width: 480px) {
    .experience-card {
      padding: 1rem;
    }

    .company-block {
      gap: 0.625rem;
    }

    .company-icon {
      width: 34px;
      height: 34px;
    }

    .company-name {
      font-size: 1rem;
    }
  }
</style>
