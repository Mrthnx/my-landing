---
import Section from "../Section.astro"

import { work } from "@cv"
---

<Section title="Experiencia laboral">
  <div class="experience-timeline">
    {
      work.map(
        ({ name, startDate, endDate, position, summary, highlights, url }, index) => {
          const startYear = new Date(startDate).getFullYear()
          const endYear =
            endDate != null ? new Date(endDate).getFullYear() : "Actual"

          return (
            <div class="timeline-item">
              <div class="timeline-marker">
                <div class="timeline-dot"></div>
                {index < work.length - 1 && <div class="timeline-line"></div>}
              </div>
              <div class="timeline-content">
                <div class="experience-card">
                  <div class="card-header">
                    <div class="company-info">
                      <h3 class="company-name">
                        <a href={url} title={`Ver ${name}`} target="_blank">
                          {name}
                        </a>
                      </h3>
                      <h4 class="position-title">{position}</h4>
                    </div>
                    <div class="date-range">
                      <span class="date-badge">
                        <time datetime={startDate}>{startYear}</time>
                        <span class="date-separator">-</span>
                        <time datetime={endDate}>{endYear}</time>
                      </span>
                    </div>
                  </div>
                  <div class="card-body">
                    <p class="job-description">{summary}</p>
                    {highlights && highlights.length > 0 && (
                      <div class="highlights">
                        {highlights.map((highlight) => (
                          <span class="highlight-tag">{highlight}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          )
        }
      )
    }
  </div>
</Section>

<style>
  .experience-timeline {
    position: relative;
  }

  .timeline-item {
    display: flex;
    gap: 2rem;
    margin-bottom: 3rem;
    position: relative;
  }

  .timeline-marker {
    position: relative;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
  }

  .timeline-dot {
    width: 16px;
    height: 16px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.3);
    position: relative;
  }

  .timeline-dot::after {
    content: '';
    position: absolute;
    width: 8px;
    height: 8px;
    background: white;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .timeline-line {
    width: 2px;
    height: 100px;
    background: linear-gradient(to bottom, rgba(59, 130, 246, 0.5), rgba(59, 130, 246, 0.1));
    margin-top: 1rem;
  }

  .timeline-content {
    flex: 1;
    min-width: 0;
  }

  .experience-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 2rem;
    backdrop-filter: blur(10px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .experience-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.5), transparent);
  }

  .experience-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-4px);
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }

  .company-info {
    flex: 1;
    min-width: 0;
  }

  .company-name {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .company-name a {
    color: #f1f5f9;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .company-name a:hover {
    color: #3b82f6;
    text-shadow: 0 0 8px rgba(59, 130, 246, 0.4);
  }

  .position-title {
    font-size: 1rem;
    font-weight: 500;
    color: #94a3b8;
    margin: 0;
    line-height: 1.4;
  }

  .date-range {
    flex-shrink: 0;
  }

  .date-badge {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: #93c5fd;
    padding: 0.5rem 1rem;
    border-radius: 12px;
    font-size: 0.875rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    backdrop-filter: blur(10px);
  }

  .date-separator {
    color: rgba(147, 197, 253, 0.5);
  }

  .card-body {
    space-y: 1rem;
  }

  .job-description {
    color: #cbd5e1;
    line-height: 1.7;
    margin: 0 0 1.5rem 0;
    font-size: 0.95rem;
  }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .highlight-tag {
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.3);
    color: #c4b5fd;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 500;
    backdrop-filter: blur(10px);
  }

  @media (max-width: 768px) {
    .timeline-item {
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .experience-card {
      padding: 1.5rem;
    }

    .card-header {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .date-range {
      align-self: flex-start;
    }

    .company-name {
      font-size: 1.1rem;
    }

    .position-title {
      font-size: 0.9rem;
    }

    .timeline-line {
      height: 80px;
    }
  }

  @media (max-width: 480px) {
    .timeline-item {
      gap: 0.75rem;
    }

    .experience-card {
      padding: 1.25rem;
    }

    .highlights {
      gap: 0.375rem;
    }

    .highlight-tag {
      font-size: 0.7rem;
      padding: 0.2rem 0.6rem;
    }
  }
</style>
